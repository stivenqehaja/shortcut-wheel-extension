{
  "manifest_version": 3,
  "name": "Shortcut Wheel",
  "version": "1.0",
  "description": "Custom shortcut wheel with game-style UI",
  "icons": {
    "16": "icons/icon.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon.png"
    }
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "options_ui": {
    "page": "./options/options.html",
    "open_in_tab": true
  }
}